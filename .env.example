# === ARTbrows API Keys (예시 · 실제 값은 .env.local에) ===
# 실제 키는 절대 커밋 금지

# Google Gemini API (2026-06-29 도입)
# 발급: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=your-key-here

# Anthropic Claude API (이미 사용 중)
ANTHROPIC_API_KEY=your-key-here

# Higgsfield API (이미 사용 중)
HIGGSFIELD_API_KEY=your-key-here

# Netlify (이미 설정됨)
NETLIFY_AUTH_TOKEN=managed-by-netlify-cli

# === 차주 도입 예정 ===
# 네이버 검색광고 API
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET=

# Meta Marketing API (Facebook + Instagram)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Google Ads API
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
